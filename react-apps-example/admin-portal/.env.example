# Cognito Configuration
REACT_APP_COGNITO_AUTHORITY=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_YOUR_USER_POOL_ID
REACT_APP_COGNITO_CLIENT_ID=your-admin-client-id-here
REACT_APP_COGNITO_DOMAIN=https://your-domain.auth.us-east-1.amazoncognito.com

# API Configuration
REACT_APP_API_BASE_URL=https://api.yourdomain.com

# Application URLs
REACT_APP_MAIN_APP_URL=https://app.yourdomain.com
REACT_APP_ADMIN_APP_URL=https://admin.yourdomain.com
REACT_APP_API_APP_URL=https://api.yourdomain.com