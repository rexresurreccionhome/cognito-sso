# Development-specific overrides
REACT_APP_USE_EXTERNAL_IDP=true
REACT_APP_ENABLE_SOCIAL_LOGIN=true

# Development Cognito Configuration
REACT_APP_COGNITO_DOMAIN=https://your-dev-domain.auth.us-east-1.amazoncognito.com

# Development API URLs
REACT_APP_API_BASE_URL=http://localhost:3001
REACT_APP_MAIN_APP_URL=http://localhost:3000
REACT_APP_ADMIN_APP_URL=http://localhost:3002